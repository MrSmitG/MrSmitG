{
  "name": "local-forge",
  "version": "0.3.0",
  "private": true,
  "description": "Cursor-like AI coding IDE powered by local LLMs — choose, download, and run models offline",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-monaco.mjs",
    "vendor:monaco": "node scripts/vendor-monaco.mjs",
    "dev": "npm run vendor:monaco && concurrently -k -n server,web -c teal,amber \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run vendor:monaco && tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "test": "tsx --test server/**/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.2"
  }
}
